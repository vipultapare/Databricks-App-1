# Databricks SQL Warehouse Connection Configuration
# Obtain these values from Databricks:
# 1. Open your Databricks workspace.
# 2. Go to "SQL Warehouses" in the left sidebar.
# 3. Click on your active SQL Warehouse.
# 4. Navigate to the "Connection details" tab.

# Server Hostname (do NOT include https:// prefix or trailing slashes)
# Example: adb-1234567890123456.7.azuredatabricks.net or your-org.cloud.databricks.com
DATABRICKS_SERVER_HOSTNAME=your-databricks-instance.cloud.databricks.com

# HTTP Path for the SQL Warehouse
# Example: /sql/1.0/warehouses/a1b2c3d4e5f6g7h8
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id

# -------------------------------------------------------------
# Authentication Configuration (Choose one option):
# -------------------------------------------------------------

# Option 1: Personal Access Token (PAT) - Recommended for Databricks Free Edition & Local Testing
# Create a PAT in: User Settings -> Developer -> Access tokens -> Generate new token
DATABRICKS_TOKEN=your_personal_access_token_here

# Option 2: Databricks OAuth (User-to-Machine / U2M interactive login)
# Set to 'databricks-oauth' to trigger browser-based interactive authentication
# (Leave DATABRICKS_TOKEN empty if using this)
# DATABRICKS_AUTH_TYPE=databricks-oauth

# Option 3: Databricks OAuth (Machine-to-Machine / Service Principal)
# DATABRICKS_CLIENT_ID=your_client_id
# DATABRICKS_CLIENT_SECRET=your_client_secret
